TUBEON_LLM_PROVIDER=offline
# TUBEON_LLM_PROVIDER=ollama
TUBEON_OLLAMA_BASE_URL=http://127.0.0.1:11434
TUBEON_OLLAMA_MODEL=qwen2.5:7b
# TUBEON_LLM_PROVIDER=openai
# TUBEON_OPENAI_API_KEY=
# TUBEON_OPENAI_BASE_URL=https://api.openai.com/v1
# TUBEON_OPENAI_MODEL=gpt-4o-mini
TUBEON_CHUNK_SECONDS=90
TUBEON_HOST=127.0.0.1
TUBEON_PORT=8765

# ASR when YouTube captions are off: whisper | whisperx | deepgram
TUBEON_ASR_PROVIDER=whisper
# small (CPU) | large-v3-turbo (better; GPU recommended)
TUBEON_WHISPER_MODEL=small
# TUBEON_WHISPER_DEVICE=cuda
# TUBEON_WHISPER_COMPUTE=float16
# A/B sync report (free/local):
#   python scripts/compare_asr.py <videoId> --model large-v3-turbo
# Optional cloud:
# TUBEON_DEEPGRAM_API_KEY=
# TUBEON_DEEPGRAM_MODEL=nova-3

# Optional Netscape cookies.txt when yt-dlp gets YouTube bot-check
# TUBEON_YT_COOKIES=C:\path\to\cookies.txt

# E_Main sidebar vision (primary Martin list; Potent is secondary)
# TUBEON_OPENAI_API_KEY=
# TUBEON_VISION_MODEL=gpt-4o-mini
# TUBEON_VISION_OLLAMA_MODEL=llava
# TUBEON_WATCHLIST_VISION=true
# TUBEON_WATCHLIST_VISION_FRAMES=3

# Post-extract TV Desktop CDP upload (Windows local; keeps ### sections)
# Requires NineEdge screening checkout + launch_tv_debug.bat (port 9222).
# Does NOT use flat MCP watchlist_add.
# TUBEON_TV_UPLOAD=1
# TUBEON_TV_SCREENING_ROOT=C:\Users\kinao\OneDrive\桌面\stock\screening
# TUBEON_TV_CDP_PORT=9222
# TUBEON_TV_NODE=node
# TUBEON_TV_AUTO_LAUNCH=1

